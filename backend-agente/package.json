{
  "name": "backend-agente",
  "version": "1.0.0",
  "description": "API NestJS + TypeORM del agente de reportes ambientales (reglas, QA/QC, reportes, RAG con pgvector)",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "ts-node src/main.ts",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:db": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.db.config.js",
    "evaluar": "node evaluacion/evaluar.mjs",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d typeorm.config.ts",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d typeorm.config.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d typeorm.config.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.9",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.9",
    "@nestjs/platform-express": "^11.2.9",
    "@nestjs/swagger": "^11.4.8",
    "@nestjs/typeorm": "^11.0.3",
    "@resvg/resvg-js": "^2.6.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "csv-parse": "^7.0.3",
    "docx": "^9.15.3",
    "dotenv": "^18.0.10",
    "exceljs": "^4.4.0",
    "helmet": "^8.3.0",
    "mammoth": "^1.13.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.2",
    "undici": "^8.12.4",
    "unpdf": "^2.1.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.9",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "jest": "^29.7.0",
    "jszip": "^3.10.2",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
