# Copia este archivo a .env y ajústalo. El backend NO arranca si falta una variable obligatoria (fail-fast).
# Estos valores sirven para desarrollo local con la base de `docker compose up -d db` (puerto 5433).

# --- Base de datos (obligatorias) ---
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USERNAME=agente
DB_PASSWORD=agente_local
DB_DATABASE=agente_ambiental

# --- Servidor ---
PORT=4000
HOST=127.0.0.1
CORS_ORIGINS=http://127.0.0.1:3100,http://localhost:3100

# --- Ollama (el modelo corre en este PC) ---
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen2.5:14b
# EmbeddingGemma (768 dim.). Con nomic-embed-text el umbral medido era 0.65; con EmbeddingGemma, 0.3 (ver configuration.ts).
OLLAMA_EMBEDDING_MODEL=embeddinggemma
SIMILARITY_MIN=0.3

# --- Carpetas (por defecto, relativas a backend-agente/) ---
# KNOWLEDGE_DIR=./knowledge
# DATA_DIR=./data
# REPORTS_DIR=./storage/reports

# --- Chat libre (pantalla "Chat"): Ollama + DeepSeek + Claude con tu suscripción ---
# DeepSeek: API compatible con OpenAI. Hoy va por OpenRouter (la cuenta directa de DeepSeek no tiene saldo).
DEEPSEEK_URL=https://openrouter.ai/api/v1
DEEPSEEK_API_KEY=
# DEEPSEEK_MODELS=deepseek/deepseek-v4.1-flash,deepseek/deepseek-v4-pro   # vacío = se piden a GET /models
# DEEPSEEK_MAX_TOKENS=8000
# Claude: usa la sesión de Claude Code de este PC (`claude auth login`). En Docker: CLAUDE_CODE_OAUTH_TOKEN (de `claude setup-token`).
# CLAUDE_MODELS=            # vacío = todo el catálogo (llm/constants/modelos-claude.ts)
# CLAUDE_MODELO_POR_DEFECTO=claude-opus-5-5
# CLAUDE_CLI=               # ruta a Claude Code si no está en el PATH
# CHAT_HISTORIAL_MAXIMO=40
# CHAT_ADJUNTO_MAX_MB=20

# --- Voz (contenedor stt: Whisper para escuchar, Kokoro para hablar) ---
STT_URL=http://127.0.0.1:8000
# STT_MODEL=deepdml/faster-whisper-large-v3-turbo-ct2
# STT_IDIOMA=es
# TTS_MODEL=speaches-ai/Kokoro-82M-v1.0-ONNX-fp16
# TTS_VOZ=ef_dora
# TTS_VOCES=ef_dora,em_alex,em_santa
