# Copia este archivo como .env (junto a docker-compose.yml). Docker Compose lo lee y pasa estos valores al backend.
# Todo es OPCIONAL: sin estas claves el agente ambiental funciona igual (Ollama, Whisper y Kokoro son locales);
# solo el "Chat libre" pierde DeepSeek y Claude.

# DeepSeek por OpenRouter (https://openrouter.ai/keys) o por la API directa (https://api.deepseek.com)
DEEPSEEK_URL=https://openrouter.ai/api/v1
DEEPSEEK_API_KEY=
DEEPSEEK_MODELS=deepseek/deepseek-v4.1-flash,deepseek/deepseek-v4-pro,deepseek/deepseek-chat-v3.1,deepseek/deepseek-r1-0528

# Claude con tu suscripción: en el PC ejecuta `claude setup-token` y pega aquí el token que imprime.
CLAUDE_CODE_OAUTH_TOKEN=
